# 复制为仓库根 .env（已 gitignore，勿提交真实 key）。
#
# ArenaAnything：`arena init --case <id>` 默认读本文件（或环境变量 ARENAANYTHING_SECRETS）。
#   按每个 profile 的 litellm，把需要的 *_API_KEY 写入 case/.../ssj-*/.env；
#   池子里已填的 *_API_BASE 也会一并拷贝（留空则用 ssj 内置默认 URL）。
# 手工 ssj / arena run：只读各 ssj-<profile>/ 进程根下的 .env，不直接读仓库根。
#
# 可选 provider 整段可注释，需要时取消注释并填值。

# --- DeepSeek (profile ds) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=

# --- Kimi / Moonshot (profile kimi) ---
# MOONSHOT_API_KEY=
# MOONSHOT_API_BASE=

# --- JEV / TypeSafe (profile jev) ---
# TYPESAFE_API_KEY=
# TYPESAFE_API_BASE=

# --- OpenRouter (profile mimo 等 openrouter/...) ---
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=

# --- OpenAI / GPT（litellm openai/gpt-4o 等，或自建 alias）---
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# --- 智谱 GLM（内置 alias glm → zai/glm-4.7）---
# ZAI_API_KEY=
# ZAI_API_BASE=

# --- xAI Grok（内置 alias grok → xai/grok-2-1212）---
# XAI_API_KEY=
# XAI_API_BASE=

# --- Claude ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=

# --- Gemini ---
# GEMINI_API_KEY=
# GEMINI_API_BASE=

# --- 本机 Ollama（无 API key）---
# OLLAMA_API_BASE=http://127.0.0.1:11434

# --- MiMo 直连（非 OpenRouter，litellm xiaomi_mimo/...）---
# XIAOMI_MIMO_API_KEY=
# XIAOMI_MIMO_API_BASE=

# ---------------------------------------------------------------------------
# 以下仅数据库 bootstrap；与 arena / ssj 模型密钥无关。
# ---------------------------------------------------------------------------
# SSJ_PG_HOST=127.0.0.1
# SSJ_PG_PORT=5432
# SSJ_PG_USER=arenaanything
# SSJ_PG_PASSWORD=arenaanything
# SSJ_PG_DATABASE=arenaanything
# SSJ_PG_POOL_SIZE=5
# SSJ_PG_ADMIN_USER=postgres
# SSJ_PG_ADMIN_PASSWORD=
